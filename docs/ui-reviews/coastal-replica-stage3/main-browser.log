<script type="module">
import './core.test.js';
import './architecture.test.js';
import './ui.test.js';
import './gameplay.test.js';
import './gameplay-ui.test.js';
import './pixel.test.js';
import './pixel-ui.test.js';
import './pilot-sprites.test.js';
import './storyboard-guide.test.js';
import './dialogue-sprites.test.js';
import './interaction-map.test.js';
import './coastal-ui.test.js';
import {runAll} from './harness.js';
const results = await runAll(); const root = document.querySelector('#results'); root.replaceChildren();
for(const r of results) { const p = document.createElement('pre'); p.className=r.ok?'ok':'bad'; p.textContent=`${r.ok?'ok':'FAIL'} ${r.name}${r.error?'\n'+r.error:''}`; root.append(p); }
const summary=document.createElement('p'); summary.className=results.every(r=>r.ok)?'ok':'bad'; summary.textContent=`${results.filter(r=>r.ok).length}/${results.length} passed`; root.append(summary);
window.testResults=results;
const dialogueAudit=document.createElement('pre');dialogueAudit.id='dialogue-art-audit';dialogueAudit.textContent=JSON.stringify(window.dialogueArtAudit,null,2);root.append(dialogueAudit);
const benchmarks=document.createElement('pre'); benchmarks.id='benchmarks'; benchmarks.textContent=JSON.stringify(window.pressClubBenchmarks,null,2); root.append(benchmarks);
const gameplay=document.createElement('pre'); gameplay.id='gameplay-benchmarks'; gameplay.textContent=JSON.stringify(window.gameplayBenchmarks,null,2); root.append(gameplay);
</script>
