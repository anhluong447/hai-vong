{
  "type": "object",
  "required": [
    "id",
    "kind",
    "schemaVersion",
    "exportRoot",
    "maxImageDimension",
    "licenses",
    "entries",
    "atlases",
    "generationInputs",
    "bundlePath",
    "bundleVersion",
    "sourceRoot"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "asset-imports"
      ]
    },
    "schemaVersion": {
      "enum": [
        1
      ]
    },
    "exportRoot": {
      "type": "string",
      "pattern": "^assets/exports(?:/[A-Za-z0-9_-]+)*$"
    },
    "maxImageDimension": {
      "type": "integer",
      "minimum": 1
    },
    "licenses": {
      "type": "object"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "required",
          "license"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
          },
          "kind": {
            "enum": [
              "image",
              "audio"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "quality": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "sampleRate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 384000
          },
          "channels": {
            "enum": [
              1,
              2
            ]
          },
          "fallbackId": {
            "type": "string",
            "minLength": 1
          },
          "missingPolicy": {
            "enum": [
              "silence"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "crop": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "resize": {
            "type": "object",
            "required": [
              "width",
              "height",
              "sampling"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "sampling": {
                "enum": [
                  "pixel",
                  "smooth"
                ]
              }
            }
          },
          "canvas": {
            "type": "object",
            "required": [
              "width",
              "height",
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "blur": {
            "type": "object",
            "required": [
              "radius"
            ],
            "properties": {
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 16
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "atlases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "members",
          "padding",
          "maxSize"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,79}$"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "padding": {
            "type": "integer",
            "minimum": 0
          },
          "maxSize": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "generationInputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bundlePath": {
      "type": "string",
      "pattern": "^assets/bundles/[A-Za-z0-9_.-]+\\.zip$"
    },
    "bundleVersion": {
      "type": "integer",
      "minimum": 1
    },
    "sourceRoot": {
      "enum": [
        "assets/sources"
      ]
    }
  }
}
