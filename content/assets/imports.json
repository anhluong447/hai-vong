{
  "schemaVersion": 1,
  "exportRoot": "assets/exports",
  "maxImageDimension": 4096,
  "licenses": {
    "LicenseRef-ProjectFixture": {
      "provenance": "tools/pipeline/generate_fixtures.py + assets/sources/fixture-inputs.json",
      "usage": "internal-development",
      "productionApproved": false
    }
  },
  "entries": [
    {
      "id": "image.fixture.scene",
      "kind": "image",
      "source": "assets/sources/scene.png",
