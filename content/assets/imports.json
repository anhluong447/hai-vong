      "license": "LicenseRef-ProjectFixture"
    },
    {
      "id": "image.fixture.placeholder",
      "kind": "image",
      "source": "assets/sources/placeholder.png",
      "required": true,
      "license": "LicenseRef-ProjectFixture"
    },
    {
      "id": "image.fixture.actor0",
      "kind": "image",
      "source": "assets/sources/actor-0.png",
      "required": true,
      "license": "LicenseRef-ProjectFixture"
    },
    {
      "id": "image.fixture.actor1",
      "kind": "image",
      "source": "assets/sources/actor-1.png",
      "required": true,
      "license": "LicenseRef-ProjectFixture"
    },
    {
      "id": "audio.fixture.tone",
      "kind": "audio",
      "source": "assets/sources/tone.wav",
      "required": true,
      "license": "LicenseRef-ProjectFixture",
      "quality": 4,
      "sampleRate": 44100,
      "channels": 1
    }
  ],
  "generationInputs": [
    "assets/sources/fixture-inputs.json"
